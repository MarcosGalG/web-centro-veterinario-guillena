---
import MapPin from "@lucide/astro/icons/map-pin";
import Phone from "@lucide/astro/icons/phone";
import Mail from "@lucide/astro/icons/mail";
import BrandIcon from "@/components/BrandIcon.astro";
import OpeningHours from "@/components/OpeningHours.astro";
import Seahorse from "@/components/Seahorse.astro";
import { clinic, whatsappUrl } from "@/data/clinic";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={`${clinic.name}, inicio`}>
          <Seahorse class="footer__mark" />
          <span>{clinic.name}</span>
        </a>
        <p class="footer__tagline">{clinic.tagline}</p>
        <p class="footer__vet">
          {clinic.vet.name} · Colegiado nº {clinic.vet.licenseNumber} (Sevilla)
        </p>
        <div class="footer__social">
          <a href={clinic.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <BrandIcon name="instagram" size={22} />
          </a>
          <a href={clinic.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <BrandIcon name="facebook" size={22} />
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener" aria-label="WhatsApp">
            <BrandIcon name="whatsapp" size={22} />
          </a>
        </div>
      </div>

      <div>
        <h2 class="footer__title">Contacto</h2>
        <address class="footer__list">
          <a href={clinic.maps.directionsUrl} target="_blank" rel="noopener">
            <MapPin size={18} aria-hidden="true" />
            <span>
              {clinic.address.street}<br />
              {clinic.address.postalCode}
              {clinic.address.city}, {clinic.address.province}
            </span>
          </a>
          <a href={`tel:${clinic.phones.landline.e164}`}>
            <Phone size={18} aria-hidden="true" />
            <span>{clinic.phones.landline.display}</span>
          </a>
          <a href={`tel:${clinic.phones.mobile.e164}`}>
            <Phone size={18} aria-hidden="true" />
            <span>{clinic.phones.mobile.display}</span>
          </a>
          <a href={`mailto:${clinic.email}`}>
            <Mail size={18} aria-hidden="true" />
            <span>{clinic.email}</span>
          </a>
        </address>
      </div>

      <div>
        <h2 class="footer__title">Horario</h2>
        <OpeningHours compact />
      </div>

      <div>
        <h2 class="footer__title">Navegación</h2>
        <ul class="footer__nav">
          <li><a href="/">Inicio</a></li>
          <li><a href="/servicios/">Servicios</a></li>
          <li><a href="/equipo/">Equipo</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {clinic.name}. Todos los derechos reservados.</p>
      <ul class="footer__legal">
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li>
          <a href="https://github.com/MarcosGalG" target="_blank" rel="noopener"
            >Web por Marcos Galán</a
          >
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-900);
    color: var(--ink-200);
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem;
    margin-top: auto;
    font-size: var(--text-sm);
  }
  .footer a {
    color: inherit;
    text-decoration: none;
  }
  .footer a:hover {
    color: #fff;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 0.7fr;
    }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
  }
  .footer__logo :global(.footer__mark) {
    width: 2.1rem;
    flex: none;
    --sh-body: #fff;
    --sh-accent: var(--red-600);
    transition: transform 0.6s var(--ease-out-expo);
  }
  .footer__logo:hover :global(.footer__mark) {
    transform: translateY(-3px) rotate(-6deg);
  }
  .footer__tagline {
    margin: 1rem 0 0.4rem;
    max-width: 34ch;
  }
  .footer__vet {
    color: var(--ink-300);
    font-size: var(--text-xs);
  }
  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .footer__social a {
    display: inline-flex;
    padding: 0.55rem;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.08);
    transition: background-color 0.15s var(--ease);
  }
  .footer__social a:hover {
    background: var(--red-600);
    color: #fff;
  }

  .footer__title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1rem;
  }

  .footer__list {
    display: grid;
    gap: 0.7rem;
  }
  .footer__list a {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .footer__list svg {
    flex: none;
    margin-top: 0.15em;
    color: var(--red-600);
  }

  .footer__nav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--text-xs);
    color: var(--ink-300);
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__legal {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
</style>
