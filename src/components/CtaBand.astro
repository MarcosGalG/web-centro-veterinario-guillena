---
import Phone from "@lucide/astro/icons/phone";
import BrandIcon from "@/components/BrandIcon.astro";
import Bubbles from "@/components/Bubbles.astro";
import Seahorse from "@/components/Seahorse.astro";
import { clinic, whatsappUrl } from "@/data/clinic";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "¿Tu mascota necesita una revisión?",
  text = "Llámanos o escríbenos por WhatsApp y te damos cita. Sin esperas innecesarias y con un trato cercano.",
} = Astro.props;
---

<section class="cta section--deep">
  <Bubbles count={10} tone="light" class="cta__bubbles" />
  <Seahorse variant="ghost" class="cta__mark is-swaying" />

  <div class="container cta__inner">
    <div class="cta__text-block">
      <h2 class="cta__title reveal-words">{title}</h2>
      <p class="cta__text" data-reveal="up" style="--reveal-delay:120ms">{text}</p>
    </div>
    <div class="cta__actions" data-reveal="up" style="--reveal-delay:200ms">
      <a href={`tel:${clinic.phones.landline.e164}`} class="btn btn--primary btn--lg magnetic">
        <Phone size={18} aria-hidden="true" />
        {clinic.phones.landline.display}
      </a>
      <a
        href={whatsappUrl}
        class="btn btn--whatsapp btn--lg magnetic"
        target="_blank"
        rel="noopener"
      >
        <BrandIcon name="whatsapp" size={18} />
        WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .cta :global(.cta__bubbles) {
    opacity: 0.45;
  }
  .cta :global(.cta__mark) {
    position: absolute;
    right: 3%;
    top: 50%;
    width: min(28vw, 260px);
    translate: 0 -50%;
    color: #fff;
    opacity: 0.05;
    z-index: 0;
  }
  .cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta__text-block {
    max-width: 52ch;
  }
  .cta__title {
    margin-bottom: 0.5rem;
  }
  .cta__text {
    margin: 0;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
