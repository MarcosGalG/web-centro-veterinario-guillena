---
/**
 * Click-to-load Google Maps embed.
 *
 * The iframe is only injected after the visitor asks for it. That keeps the page
 * fast (no third-party JS on load) and avoids setting Google cookies without
 * consent, which is what lets the site run without a cookie banner.
 */
import MapPin from "@lucide/astro/icons/map-pin";
import Navigation from "@lucide/astro/icons/navigation";
import { clinic, fullAddress } from "@/data/clinic";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["map", className]} data-map data-src={clinic.maps.embedUrl}>
  <div class="map__placeholder">
    <div class="map__pin">
      <MapPin size={28} aria-hidden="true" />
    </div>
    <p class="map__address">{fullAddress}</p>
    <div class="map__actions">
      <button type="button" class="btn btn--primary" data-map-load>Ver mapa</button>
      <a href={clinic.maps.directionsUrl} class="btn btn--secondary" target="_blank" rel="noopener">
        <Navigation size={16} aria-hidden="true" />
        Cómo llegar
      </a>
    </div>
    <p class="map__note">
      Al cargar el mapa se conectará con Google Maps, que puede instalar cookies.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-map]").forEach((map) => {
    const button = map.querySelector<HTMLButtonElement>("[data-map-load]");
    const src = map.dataset.src;
    if (!button || !src) return;

    button.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = "Mapa con la ubicación del Centro Veterinario Guillena";
      iframe.loading = "lazy";
      iframe.referrerPolicy = "no-referrer-when-downgrade";
      iframe.allowFullscreen = true;
      map.replaceChildren(iframe);
      map.classList.add("map--loaded");
    });
  });
</script>

<style>
  .map {
    position: relative;
    min-height: 380px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, rgb(179 25 31 / 0.06), transparent 45%),
      repeating-linear-gradient(0deg, transparent 0 39px, rgb(27 25 23 / 0.05) 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, rgb(27 25 23 / 0.05) 39px 40px),
      var(--ink-100);
    border: 1px solid var(--ink-200);
  }
  .map--loaded {
    border: 0;
  }
  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    gap: 0.75rem;
  }
  .map__pin {
    display: inline-flex;
    padding: 0.9rem;
    border-radius: 50%;
    background: var(--red-600);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgb(179 25 31 / 0.7);
  }
  .map__address {
    margin: 0;
    font-weight: 600;
    max-width: 30ch;
  }
  .map__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }
  .map__note {
    margin: 0.5rem 0 0;
    font-size: var(--text-xs);
    color: var(--ink-500);
    max-width: 38ch;
  }
</style>
