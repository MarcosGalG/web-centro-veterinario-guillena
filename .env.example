# Copy to `.dev.vars` for local testing with `wrangler pages dev`, and set the same
# variables in Cloudflare Pages > Settings > Environment variables for production.

# Resend API key (https://resend.com). Free tier is enough for a clinic's contact form.
RESEND_API_KEY=re_xxxxxxxxx

# Address that receives the contact form messages (the clinic's inbox).
CONTACT_TO_EMAIL=packsev@hotmail.com

# Sender address. Must belong to a domain verified in Resend.
CONTACT_FROM_EMAIL=web@centroveterinarioguillena.com

# Optional: Cloudflare Turnstile (free CAPTCHA). Leave unset to rely on the honeypot only.
# The public site key is read at build time by Astro (PUBLIC_ prefix); the secret at request time.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
