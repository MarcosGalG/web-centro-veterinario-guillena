---
import BrandIcon from "@/components/BrandIcon.astro";
import { whatsappUrl } from "@/data/clinic";
---

<a
  href={whatsappUrl}
  class="whatsapp-fab"
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
>
  <BrandIcon name="whatsapp" size={28} />
  <span class="whatsapp-fab__label">WhatsApp</span>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem;
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: #062d14;
    text-decoration: none;
    font-weight: 600;
    font-size: var(--text-sm);
    box-shadow: 0 10px 24px -8px rgb(37 211 102 / 0.7);
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .whatsapp-fab:hover {
    transform: translateY(-2px);
    color: #062d14;
    box-shadow: 0 14px 28px -8px rgb(37 211 102 / 0.8);
  }
  .whatsapp-fab__label {
    display: none;
  }
  @media (min-width: 640px) {
    .whatsapp-fab {
      padding: 0.75rem 1.2rem 0.75rem 0.9rem;
    }
    .whatsapp-fab__label {
      display: inline;
    }
  }
</style>
