---
import Check from "@lucide/astro/icons/check";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ServiceIcon from "@/components/ServiceIcon.astro";
import CtaBand from "@/components/CtaBand.astro";
import { services } from "@/data/services";
import { clinic } from "@/data/clinic";

const description = `Servicios veterinarios en Guillena: consultas, vacunación, diagnóstico por imagen y laboratorio, cirugía, salud dental, tienda especializada y atención a domicilio. ${clinic.name}.`;
---

<BaseLayout title="Servicios veterinarios" description={description}>
  <PageHeader
    eyebrow="Servicios"
    title="Cuidado completo para perros, gatos y pequeños animales"
    text="Medicina preventiva, diagnóstico, cirugía y todo lo que tu mascota necesita en su día a día. Siempre con cita previa y sin esperas innecesarias."
  />

  <nav class="jump" aria-label="Índice de servicios">
    <div class="container jump__inner">
      {
        services.map((s, i) => (
          <a href={`#${s.slug}`} data-jump-link>
            <span class="jump__num tabular">{String(i + 1).padStart(2, "0")}</span>
            {s.title}
          </a>
        ))
      }
    </div>
  </nav>

  <div class="services">
    {
      /* A single line threads the whole page, filling in as you scroll: the
        seahorse's tail, unrolled. */
    }
    <div class="thread" aria-hidden="true">
      <div class="thread__track"></div>
      <div class="thread__fill" data-thread-fill></div>
    </div>

    <div class="container">
      {
        services.map((service, index) => (
          <section id={service.slug} class="service" data-service>
            <div class="service__aside">
              <span class="service__index tabular" data-reveal="fade">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="service__tile" data-reveal="zoom" aria-hidden="true">
                <ServiceIcon name={service.icon} size={68} />
              </div>
            </div>

            <div class="service__body">
              <h2 class="reveal-words">{service.title}</h2>
              <p class="lead" data-reveal="up" style="--reveal-delay:120ms">
                {service.description}
              </p>
              <ul class="check-list">
                {service.items.map((item, i) => (
                  <li data-reveal="up" style={`--reveal-delay:${180 + i * 70}ms`}>
                    <Check size={18} aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <CtaBand
    title="¿No encuentras lo que buscas?"
    text="Cuéntanos qué necesita tu mascota. Si no lo hacemos nosotros, te orientamos sobre a quién acudir."
  />
</BaseLayout>

<script>
  function setupServices() {
    const fill = document.querySelector<HTMLElement>("[data-thread-fill]");
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-service]"));
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-jump-link]"));
    if (!fill || !sections.length) return;

    const track = fill.parentElement!;
    let frame = 0;

    const update = () => {
      frame = 0;
      const rect = track.getBoundingClientRect();
      const viewMiddle = window.innerHeight * 0.55;
      // 0 when the first service reaches the reading line, 1 at the last.
      const progress = (viewMiddle - rect.top) / rect.height;
      fill.style.setProperty("--thread-progress", String(Math.min(Math.max(progress, 0), 1)));

      // Highlight the service currently under the reading line.
      let active = -1;
      sections.forEach((section, i) => {
        const box = section.getBoundingClientRect();
        if (box.top <= viewMiddle && box.bottom > viewMiddle) active = i;
      });
      links.forEach((link, i) => link.classList.toggle("is-current", i === active));
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  setupServices();
  document.addEventListener("astro:page-load", setupServices);
</script>

<style>
  /* ---------------- sticky index ---------------- */
  .jump {
    position: sticky;
    top: 4rem;
    z-index: 30;
    background: rgb(250 248 245 / 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ink-100);
  }
  .jump__inner {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    padding-block: 0.6rem;
    scrollbar-width: none;
  }
  .jump__inner::-webkit-scrollbar {
    display: none;
  }
  .jump a {
    flex: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-500);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.35s var(--ease-out-soft),
      color 0.35s var(--ease-out-soft);
  }
  .jump a:hover {
    background: var(--red-50);
    color: var(--red-700);
  }
  .jump a.is-current {
    background: var(--red-600);
    color: #fff;
  }
  .jump__num {
    font-size: 0.7em;
    opacity: 0.7;
  }

  /* ---------------- thread ---------------- */
  .services {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .thread {
    position: absolute;
    left: max(var(--gutter), calc(50% - var(--container) / 2));
    top: clamp(2.5rem, 6vw, 4rem);
    bottom: clamp(2.5rem, 6vw, 4rem);
    width: 2px;
    display: none;
  }
  @media (min-width: 900px) {
    .thread {
      display: block;
    }
  }
  .thread__track {
    position: absolute;
    inset: 0;
    background: var(--ink-100);
    border-radius: 2px;
  }
  .thread__fill {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100%;
    background: linear-gradient(180deg, var(--red-600), var(--red-700));
    border-radius: 2px;
    transform-origin: top;
    transform: scaleY(var(--thread-progress, 0));
    transition: transform 0.15s linear;
  }

  /* ---------------- service blocks ---------------- */
  .service {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: start;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    scroll-margin-top: 9rem;
  }
  .service + .service {
    border-top: 1px solid var(--ink-100);
  }
  @media (min-width: 900px) {
    .service {
      grid-template-columns: 220px 1fr;
      padding-left: 3.5rem;
    }
  }

  .service__aside {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .service__aside {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      position: sticky;
      top: 9rem;
    }
  }
  .service__index {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    color: var(--red-100);
  }
  .service__tile {
    display: grid;
    place-items: center;
    width: clamp(5rem, 14vw, 9.5rem);
    aspect-ratio: 1;
    border-radius: 58% 42% 46% 54% / 46% 52% 48% 54%;
    background: radial-gradient(circle at 32% 28%, #fff, var(--red-50) 70%);
    border: 1px solid var(--red-100);
    color: var(--red-700);
    animation: blob 24s var(--ease-in-out-swim) infinite;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .service:hover .service__tile {
    transform: translateY(-6px) rotate(-3deg);
  }

  .service__body h2 {
    margin-bottom: 0.75rem;
  }
  .service__body .lead {
    margin-bottom: 1.25rem;
    max-width: 62ch;
  }
</style>
