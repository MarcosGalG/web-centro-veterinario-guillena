---
/**
 * Decorative bubbles rising through a section — the motif that already
 * surrounds the seahorse in the clinic's logo.
 *
 * Positions are generated at build time from a fixed seed so the markup is
 * stable between builds (no hydration mismatch, no layout shift), and the
 * whole field is pure CSS: no JavaScript, no canvas, no repaint cost beyond
 * a handful of composited transforms.
 */
interface Props {
  count?: number;
  /** Multiplies every bubble's size. */
  scale?: number;
  class?: string;
  tone?: "red" | "ink" | "light";
}

const { count = 14, scale = 1, class: className, tone = "red" } = Astro.props;

// Small deterministic PRNG (mulberry32) so a given count always looks the same.
function seeded(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = seeded(20260921);
const bubbles = Array.from({ length: count }, () => {
  const size = (6 + random() * 26) * scale;
  return {
    left: random() * 100,
    size,
    duration: 16 + random() * 20,
    delay: -random() * 30,
    drift: (random() - 0.5) * 90,
    // Smaller bubbles read as further away, so they stay fainter.
    opacity: 0.12 + (size / (32 * scale)) * 0.3,
  };
});
---

<div class:list={["bubbles", `bubbles--${tone}`, className]} aria-hidden="true">
  {
    bubbles.map((b) => (
      <span
        class="bubble"
        style={`--bubble-size:${b.size.toFixed(1)}px;--bubble-left:${b.left.toFixed(2)}%;--bubble-duration:${b.duration.toFixed(1)}s;--bubble-delay:${b.delay.toFixed(1)}s;--bubble-drift:${b.drift.toFixed(0)}px;--bubble-opacity:${b.opacity.toFixed(2)}`}
      />
    ))
  }
</div>

<style>
  .bubbles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .bubble {
    position: absolute;
    bottom: -10%;
    left: var(--bubble-left);
    width: var(--bubble-size);
    height: var(--bubble-size);
    border-radius: 50%;
    opacity: 0;
    animation: rise var(--bubble-duration) linear var(--bubble-delay) infinite;
    will-change: transform, opacity;
  }

  .bubbles--red .bubble {
    background: radial-gradient(circle at 32% 30%, rgb(255 255 255 / 0.55), var(--red-600) 70%);
  }
  .bubbles--ink .bubble {
    background: radial-gradient(circle at 32% 30%, rgb(255 255 255 / 0.4), var(--ink-300) 70%);
  }
  .bubbles--light .bubble {
    background: radial-gradient(
      circle at 32% 30%,
      rgb(255 255 255 / 0.8),
      rgb(255 255 255 / 0.15) 70%
    );
    border: 1px solid rgb(255 255 255 / 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .bubbles {
      display: none;
    }
  }
</style>
